# Copy to backend/.env (gitignored). scripts/run-backend-docker.sh creates it automatically with a random key.
# Required: the shared secret the Gmail add-on sends on every call (at least 32 characters).
MAILLENS_API_KEY=replace-with-a-long-random-value-at-least-32-chars
# Optional (defaults shown): where per-account dashboard history is stored, and developer mode (keep 0).
# MAILLENS_DATA_DIR=backend/data
# MAILLENS_DEV_PROBE=0
